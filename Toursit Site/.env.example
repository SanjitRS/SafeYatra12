# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your local or MongoDB Atlas connection string:
# e.g., mongodb://localhost:27017/tourist_safety or mongodb+srv://...
# If not reachable or omitted, server automatically falls back to in-memory MongoDB for zero-config demo!
MONGODB_URI=mongodb://127.0.0.1:27017/tourist_safety

# JWT Authentication Secrets
JWT_SECRET=super_secret_tourist_safety_jwt_key_2026_x98f
JWT_EXPIRES_IN=7d

# Digital Tourist ID Cryptographic Signing Secret
# Matches the Authority backend's /verify/scan verification secret
DIGITAL_ID_SECRET=super_secret_tourist_safety_jwt_key_2026_x98f
DIGITAL_ID_VALIDITY_HOURS=48

# CORS Allowed Origins
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SOS_RATE_LIMIT_MAX=10

# AI Configuration
# Optional: External LLM API Key (if omitted, high-performance rule-based spatio-temporal risk & NLP classifier runs with zero latency)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GPS & Geospatial Map Tile API Configuration
# High-precision Carto Voyager & GPS Telemetry Key
GPS_API_KEY=cb1_2wxn_1_b75af9d604b9a9abba43bc22
CARTO_API_KEY=cb1_2wxn_1_b75af9d604b9a9abba43bc22
